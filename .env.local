# MediAssist-Bot Local Development Configuration
# Copy this to .env or export these variables before running the application

# ============================================================================
# CORE CONFIGURATION
# ============================================================================
ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================================
# CONVERSATION PERSISTENCE (Optional but Recommended)
# ============================================================================
USE_CONVERSATION_PERSISTENCE=1
# Location where conversations are stored:
# - If not set: In-memory only (lost on restart)
# - If set to 1: Stored in data/conversations.db (persists across restarts)

# ============================================================================
# RAG VECTOR SEARCH CONFIGURATION (NEW - TF-IDF)
# ============================================================================
RAG_ENABLED=1
EMBEDDING_PROVIDER=local

# RAG search parameters
SIMILARITY_THRESHOLD=0.5
TOP_K_RESULTS=5

# Vector database path (automatically created)
VECTOR_DB_PATH=./data/vector_db.sqlite3

# ============================================================================
# OPTIONAL: LLM INTEGRATION (ChatGPT)
# ============================================================================
# LLM_API_KEY=sk-your-key-here
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-3.5-turbo
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=1024

# ============================================================================
# OPTIONAL: LOCAL EMBEDDINGS (if using sentence-transformers instead of TF-IDF)
# ============================================================================
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2


# ============================================================================
# RATE LIMITING (Optional)
# ============================================================================
RATE_LIMIT_ENABLED=0
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=20

# ============================================================================
# FILE UPLOAD LIMITS
# ============================================================================
MAX_UPLOAD_BYTES=5242880
