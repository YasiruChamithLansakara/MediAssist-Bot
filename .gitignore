# -----------------------------
# Python cache and compiled files
# -----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# -----------------------------
# Virtual environments
# -----------------------------
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# -----------------------------
# Jupyter Notebook checkpoints
# -----------------------------
.ipynb_checkpoints/

# -----------------------------
# System files
# -----------------------------
.DS_Store
Thumbs.db

# -----------------------------
# IDE / Editor settings
# -----------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# -----------------------------
# Logs and temporary files
# -----------------------------
*.log
*.tmp
*.swp
*.bak

# -----------------------------
# Data and model outputs
# -----------------------------
data/quality_reports/
data/tmp/
outputs/
outputs/ocr/
runs/

# Generated FAISS binary index (rebuild from dataset on startup)
data/faiss_index/

# Generated enriched dataset (produced by fill_missing_data.py)
data/processed/drug_knowledge_enriched.csv

# ML model weights/binaries (large files — download separately)
# Keep directory structure with .gitkeep placeholders
models/**/*.bin
models/**/*.pkl
models/**/*.pt
models/**/*.pth
models/**/*.safetensors
models/**/*.onnx
# Exception: keep .gitkeep so empty dirs are tracked in git
!models/**/.gitkeep

# -----------------------------
# Uploaded images or test data
# -----------------------------
data/raw/
data/test_images/
data/sample_prescriptions/
!data/test_images/*.png  # Keep test images if needed for testing

# -----------------------------
# LLM / Embeddings cache
# -----------------------------
# Note: data/faiss_index/ is covered in the Data section above
embeddings/
vector_store/
# run-logs keep their directory but not the log files themselves
run-logs/*.log
run-logs/*.txt

# -----------------------------
# Environment / secrets
# -----------------------------
.env
*.env
config.json
mediassist/config.py  # if contains API keys

# -----------------------------
# Pytest / coverage files
# -----------------------------
.cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# -----------------------------
# Web dependencies and builds
# -----------------------------
node_modules/
build/
dist/
*.egg-info/
*.manifest
*.spec

# -----------------------------
# Colab and notebook extras
# -----------------------------
*.ipynb_checkpoints
*.ipynb_save

# -----------------------------
# Database files
# -----------------------------
*.sqlite3
*.db
