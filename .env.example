# ============================================================
#  MediAssist Bot — Environment Configuration Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ============================================================

# ── LLM PROVIDER (Llama 3.1 8B via Groq — FREE) ─────────────
# Get a free key at: https://console.groq.com
LLM_PROVIDER=groq
LLM_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# Groq model — Llama 3.1 8B Instant (project spec)
LLM_MODEL=llama-3.1-8b-instant

# LLM generation settings
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800

# Set to 1 to call LLM even when no drugs are matched (general questions)
LLM_ALWAYS_ON=0

# ── EMBEDDINGS ───────────────────────────────────────────────
# auto = try sentence-transformers first (free/local), then OpenAI, then TF-IDF
# Options: auto | openai | tfidf
EMBEDDING_BACKEND=auto

# sentence-transformers model (used when EMBEDDING_BACKEND=auto or not set)
ST_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ── RAG / FAISS ──────────────────────────────────────────────
RAG_ENABLED=0
# Use local sentence-transformers (not OpenAI) for the SQLite RAG service
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=data/faiss_index
SIMILARITY_THRESHOLD=0.5

# ── HuggingFace Hub (suppress verbose download logs after first run) ──
HF_HUB_DISABLE_PROGRESS_BARS=1
TOKENIZERS_PARALLELISM=false

# ── DATASET PATH ─────────────────────────────────────────────
# After running fill_missing_data.py, switch to the enriched dataset:
# DRUG_DATASET_PATH=data/processed/drug_knowledge_enriched.csv
DRUG_DATASET_PATH=data/processed/drug_knowledge_bot_ready_clean.csv

# ── OCR ──────────────────────────────────────────────────────
# Windows: full path to tesseract.exe  (leave empty if tesseract is on PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── SERVER ───────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=0
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=20
MAX_UPLOAD_BYTES=5242880

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
