# =============================================================================
# MediAssist — deployment configuration
#   cp .env.docker.example .env.docker   and fill in the two REQUIRED values.
#   .env.docker holds secrets: it is gitignored, keep it that way.
# =============================================================================

# --- REQUIRED -----------------------------------------------------------------

# Shared access code. Anyone with the link AND this code can use the app.
# The container refuses to start in production without it.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(12))"
ACCESS_CODE=

# Groq API key — free tier, no card: https://console.groq.com
# Without it the assistant still runs, but answers fall back to rule-based text.
LLM_API_KEY=

# --- LLM ----------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
# Tried in order if the active model is retired by the provider.
LLM_MODEL_CHAIN=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.6-27b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800

# --- App ----------------------------------------------------------------------
ENV=production
LOG_LEVEL=INFO

# Only needed if the UI is served from a DIFFERENT origin than the API.
# The container serves both together, so leave this empty for that setup.
ALLOWED_ORIGINS=

MAX_UPLOAD_BYTES=5242880
